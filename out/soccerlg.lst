    000018B6 F5               [11] 5050 	push	af ; push return
                                   5051 ;	Ordering is critical for ISR safety (no DI/EI needed):
                                   5052 ;	1. Save game seg on stack 2. Update g_Bank0Segment to sprite base
                                   5053 ;	3. Set g_YSCC_CurrentOFFR 4. Set OFFR hardware
                                   5054 ;	→ call sprites →
                                   5055 ;	5. Clear OFFR hardware 6. Clear g_YSCC_CurrentOFFR + g_Bank0Segment+7
                                   5056 ;	7. Restore game seg
                                   5057 ;	If ISR fires at any point, _YSCC_CopyPCMBlock reads g_YSCC_CurrentOFFR
                                   5058 ;	to determine what OFFR was active and restores it correctly after audio.
                                   5059 ;	Step 1: save game segment before ANY changes to g_Bank0Segment
    000018B7 3Ar06r00         [13] 5060 	ld	a,(#(_g_Bank0Segment + 6))
    000018BA F5               [11] 5061 	push	af ; game seg (< 256) on stack
    000018BB F3               [ 4] 5062 	di
                                   5063 ;	Step 2: update g_Bank0Segment to sprite base (768 = 0x0300)
                                   5064 ;	This makes the cache consistent so ISR can restore bank3 correctly.
    000018BC AF               [ 4] 5065 	xor	a
    000018BD 32r06r00         [13] 5066 	ld	(#(_g_Bank0Segment + 6)),a ; LOW = 0 (768 & 0xFF)
    000018C0 3E 03            [ 7] 5067 	ld	a,#3
    000018C2 32r07r00         [13] 5068 	ld	(#(_g_Bank0Segment + 7)),a ; HIGH = 3 (768 >> 8)
                                   5069 ;	Step 3+4: set tracking var BEFORE hardware write (ISR sees consistent state)
    000018C5 3E C0            [ 7] 5070 	ld	a,#(768>>2) & #$%11000000
    000018C7 32r00r00         [13] 5071 	ld	(#_g_YSCC_CurrentOFFR),a ; read by _YSCC_CopyPCMBlock in ISR
    000018CA F5               [11] 5072 	push	af
    000018CB 3E 01            [ 7] 5073 	ld	a,#1
    000018CD 32 FF 7F         [13] 5074 	ld	(#0x7FFF),a ; ENAR: REGEN=1 (enable register writes)
    000018D0 F1               [10] 5075 	pop	af
    000018D1 32 FE 7F         [13] 5076 	ld	(OFFR),a ; hardware OFFR = 0xC0
    000018D4 AF               [ 4] 5077 	xor	a,a
    000018D5 32 FF 7F         [13] 5078 	ld	(#0x7FFF),a ; ENAR: REGEN=0 (restore ROM reads at 7FFE)
    000018D8 FB               [ 4] 5079 	ei
    000018D9 CDrF8r18         [17] 5080 	call	SpriteFrame
                                   5081 ;	Step 5+6: restore OFFR=0 and clear tracking var atomically (DI/EI).
                                   5082 ;	Race: ISR between ld(OFFR)=0 and ld(CurrentOFFR)=0 would see stale
                                   5083 ;	CurrentOFFR=0xC0, save it as "previous OFFR", then restore 0xC0 to
                                   5084 ;	hardware — making bank3 map to game_seg+768 instead of game_seg → crash.
                                   5085 ;	DI/EI covers only the OFFR writes (~10us), negligible vs 16ms VBlank.
                                   5086 ;	REGEN=1 before OFFR write, REGEN=0 after — prevents 7FFE ROM collision.
    000018DC AF               [ 4] 5087 	xor	a,a
    000018DD F3               [ 4] 5088 	di
    000018DE 3C               [ 4] 5089 	inc	a ; A=1
    000018DF 32 FF 7F         [13] 5090 	ld	(#0x7FFF),a ; ENAR: REGEN=1
    000018E2 3D               [ 4] 5091 	dec	a ; A=0
    000018E3 32 FE 7F         [13] 5092 	ld	(OFFR),a ; hardware OFFR = 0
    000018E6 32 FF 7F         [13] 5093 	ld	(#0x7FFF),a ; ENAR: REGEN=0
    000018E9 32r00r00         [13] 5094 	ld	(#_g_YSCC_CurrentOFFR),a
    000018EC 32r07r00         [13] 5095 	ld	(#(_g_Bank0Segment + 7)),a
                                   5096 ;	Step 7: restore game segment
    000018EF F1               [10] 5097 	pop	af
    000018F0 32r06r00         [13] 5098 	ld	(#(_g_Bank0Segment + 6)),a ; restore cache LOW
    000018F3 32 00 B0         [13] 5099 	ld	(#0xB000),a ; restore bank3 hardware
    000018F6 FB               [ 4] 5100 	ei
    000018F7 C9               [10] 5101 	ret
    000018F8                       5102 	SpriteFrame::
    000018F8 7D               [ 4] 5103 	ld	a,l
    000018F9 E6 03            [ 7] 5104 	and	#3 ; 4 sprite per pagina
    000018FB 87               [ 4] 5105 	add	a,a
    000018FC 87               [ 4] 5106 	add	a,a
    000018FD 4F               [ 4] 5107 	ld	c,a ; in c the low address of the function to be called
    000018FE CB 3C            [ 8] 5108 	srl	h ; page = 768 + frame / 4
    00001900 CB 1D            [ 8] 5109 	rr	l
    00001902 CB 3C            [ 8] 5110 	srl	h
    00001904 CB 1D            [ 8] 5111 	rr	l
    00001906 3E 00            [ 7] 5112 	ld	a,#768
    00001908 85               [ 4] 5113 	add	a,l ; segments in the current offset (!)
    00001909 32r06r00         [13] 5114 	ld	(#(_g_Bank0Segment + 6) + 0),a ; prevent future possible issues on the ISR
    0000190C 32 00 B0         [13] 5115 	ld	(#0xB000),a
    0000190F 62               [ 4] 5116 	ld	h,d ; HLB = y*256+X = 2 * VRAM_address
    00001910 6B               [ 4] 5117 	ld	l,e
    00001911 29               [11] 5118 	add	hl,hl ; in h 3 bit di indirizzo per R14
    00001912 7C               [ 4] 5119 	ld	a,h
    00001913 E6 01            [ 7] 5120 	and	#1
    00001915 FD                    5121 	.db	#0xFD
    00001916 6F               [ 4] 5122 	ld	l,a ;ld iyl,a ; save R14 in iyl
    00001917 7C               [ 4] 5123 	ld	a,h
    00001918 E6 06            [ 7] 5124 	and	#6
    0000191A FD                    5125 	.db	#0xFD
    0000191B 67               [ 4] 5126 	ld	h,a ;ld iyh,a ; save vram page in iyh
    0000191C CB 3A            [ 8] 5127 	srl	d
    0000191E CB 1B            [ 8] 5128 	rr	e
    00001920 CB 18            [ 8] 5129 	rr	b
    00001922 53               [ 4] 5130 	ld	d,e
    00001923 58               [ 4] 5131 	ld	e,b ; DE = (x + y*256)/2 & 0xFFFF
    00001924 69               [ 4] 5132 	ld	l,c
    00001925 26 A0            [ 7] 5133 	ld	h,#0xA000/256
    00001927 7A               [ 4] 5134 	ld	a,d
    00001928 F6 C0            [ 7] 5135 	or	#0xC0
    0000192A 57               [ 4] 5136 	ld	d,a
    0000192B E9               [ 4] 5137 	jp	(hl)
