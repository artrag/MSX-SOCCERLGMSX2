                         00007FFF  5044 	ENAR	.equ 0x7FFF ; enable register interface
                         00007FFE  5045 	OFFR	.equ 0x7FFE ; offset register (more on this later)
                         00007FFD  5046 	CFGR	.equ 0x7FFD ; configuration bits
    000018B3 47               [ 4] 5047 	ld	b,a ; b = x , de = y
