                                   5032 ; Function CallSpriteFrame
                                   5033 ; ---------------------------------
    000018A9                       5034 _CallSpriteFrame::
                                   5035 ;./soccerlg.c:892: __endasm;
                         00007FFF  5036 	ENAR	.equ 0x7FFF ; enable register interface
                         00007FFE  5037 	OFFR	.equ 0x7FFE ; offset register (more on this later)
                         00007FFD  5038 	CFGR	.equ 0x7FFD ; configuration bits
    000018A9 47               [ 4] 5039 	ld	b,a ; b = x , de = y
    000018AA F1               [10] 5040 	pop	af ; pop return
    000018AB E1               [10] 5041 	pop	hl ; hl = frame
    000018AC F5               [11] 5042 	push	af ; push return
                                   5043 ;	Ordering is critical for ISR safety (no DI/EI needed):
                                   5044 ;	1. Save game seg on stack 2. Update g_Bank0Segment to sprite base
                                   5045 ;	3. Set g_YSCC_CurrentOFFR 4. Set OFFR hardware
                                   5046 ;	→ call sprites →
                                   5047 ;	5. Clear OFFR hardware 6. Clear g_YSCC_CurrentOFFR + g_Bank0Segment+7
                                   5048 ;	7. Restore game seg
                                   5049 ;	If ISR fires at any point, _YSCC_CopyPCMBlock reads g_YSCC_CurrentOFFR
                                   5050 ;	to determine what OFFR was active and restores it correctly after audio.
                                   5051 ;	Step 1: save game segment before ANY changes to g_Bank0Segment
    000018AD 3Ar06r00         [13] 5052 	ld	a,(#(_g_Bank0Segment + 6))
    000018B0 F5               [11] 5053 	push	af ; game seg (< 256) on stack
                                   5054 ;	Step 2: update g_Bank0Segment to sprite base (768 = 0x0300)
                                   5055 ;	This makes the cache consistent so ISR can restore bank3 correctly.
    000018B1 AF               [ 4] 5056 	xor	a
    000018B2 32r06r00         [13] 5057 	ld	(#(_g_Bank0Segment + 6)),a ; LOW = 0 (768 & 0xFF)
    000018B5 3E 03            [ 7] 5058 	ld	a,#3
    000018B7 32r07r00         [13] 5059 	ld	(#(_g_Bank0Segment + 7)),a ; HIGH = 3 (768 >> 8)
                                   5060 ;	Step 3+4: set tracking var BEFORE hardware write (ISR sees consistent state)
    000018BA 3E C0            [ 7] 5061 	ld	a,#(768>>2) & #$%11000000
    000018BC 32r00r00         [13] 5062 	ld	(#_g_YSCC_CurrentOFFR),a ; read by _YSCC_CopyPCMBlock in ISR
    000018BF 32 FE 7F         [13] 5063 	ld	(OFFR),a ; hardware OFFR = 0xC0
    000018C2 CDrD9r18         [17] 5064 	call	SpriteFrame
                                   5065 ;	Step 5+6: restore OFFR=0 and clear tracking var atomically (DI/EI).
                                   5066 ;	Race: ISR between ld(OFFR)=0 and ld(CurrentOFFR)=0 would see stale
                                   5067 ;	CurrentOFFR=0xC0, save it as "previous OFFR", then restore 0xC0 to
                                   5068 ;	hardware — making bank3 map to game_seg+768 instead of game_seg → crash.
                                   5069 ;	DI/EI covers only 2 ld instructions (~7us), negligible vs 16ms VBlank.
    000018C5 AF               [ 4] 5070 	xor	a,a
    000018C6 F3               [ 4] 5071 	di
    000018C7 32 FE 7F         [13] 5072 	ld	(OFFR),a
    000018CA 32r00r00         [13] 5073 	ld	(#_g_YSCC_CurrentOFFR),a
    000018CD FB               [ 4] 5074 	ei
    000018CE 32r07r00         [13] 5075 	ld	(#(_g_Bank0Segment + 7)),a
                                   5076 ;	Step 7: restore game segment
    000018D1 F1               [10] 5077 	pop	af
    000018D2 32 00 B0         [13] 5078 	ld	(#0xB000),a ; restore bank3 hardware
    000018D5 32r06r00         [13] 5079 	ld	(#(_g_Bank0Segment + 6)),a ; restore cache LOW
    000018D8 C9               [10] 5080 	ret
    000018D9                       5081 	SpriteFrame::
    000018D9 7D               [ 4] 5082 	ld	a,l
    000018DA E6 03            [ 7] 5083 	and	#3 ; 4 sprite per pagina
    000018DC 87               [ 4] 5084 	add	a,a
    000018DD 87               [ 4] 5085 	add	a,a
    000018DE 4F               [ 4] 5086 	ld	c,a ; in c the low address of the function to be called
    000018DF CB 3C            [ 8] 5087 	srl	h ; page = 768 + frame / 4
    000018E1 CB 1D            [ 8] 5088 	rr	l
    000018E3 CB 3C            [ 8] 5089 	srl	h
    000018E5 CB 1D            [ 8] 5090 	rr	l
    000018E7 3E 00            [ 7] 5091 	ld	a,#768
    000018E9 85               [ 4] 5092 	add	a,l ; segments in the current offset (!)
    000018EA 32 00 B0         [13] 5093 	ld	(#0xB000),a
    000018ED 32r06r00         [13] 5094 	ld	(#(_g_Bank0Segment + 6) + 0),a ; prevent future possible issues on the ISR
    000018F0 62               [ 4] 5095 	ld	h,d ; HLB = y*256+X = 2 * VRAM_address
    000018F1 6B               [ 4] 5096 	ld	l,e
    000018F2 29               [11] 5097 	add	hl,hl ; in h 3 bit di indirizzo per R14
    000018F3 7C               [ 4] 5098 	ld	a,h
    000018F4 E6 01            [ 7] 5099 	and	#1
    000018F6 FD                    5100 	.db	#0xFD
    000018F7 6F               [ 4] 5101 	ld	l,a ;ld iyl,a ; save R14 in iyl
    000018F8 7C               [ 4] 5102 	ld	a,h
    000018F9 E6 06            [ 7] 5103 	and	#6
    000018FB FD                    5104 	.db	#0xFD
    000018FC 67               [ 4] 5105 	ld	h,a ;ld iyh,a ; save vram page in iyh
    000018FD CB 3A            [ 8] 5106 	srl	d
    000018FF CB 1B            [ 8] 5107 	rr	e
    00001901 CB 18            [ 8] 5108 	rr	b
    00001903 53               [ 4] 5109 	ld	d,e
    00001904 58               [ 4] 5110 	ld	e,b ; DE = (x + y*256)/2 & 0xFFFF
    00001905 69               [ 4] 5111 	ld	l,c
    00001906 26 A0            [ 7] 5112 	ld	h,#0xA000/256
    00001908 7A               [ 4] 5113 	ld	a,d
    00001909 F6 C0            [ 7] 5114 	or	#0xC0
    0000190B 57               [ 4] 5115 	ld	d,a
    0000190C E9               [ 4] 5116 	jp	(hl)
